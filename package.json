  "keywords": [
    "node-red",
    "tecalor",
    "thz504",
    "thz-504",
    "stiebel-eltron",
    "lwz504",
    "heat-pump",
    "waermepumpe",
    "can",
    "socketcan",
    "elster",
    "home-assistant",
    "mqtt"
  ],
  "license": "MIT",
  "author": "",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "thz504-read": "nodes/thz504-read.js",
      "thz504-ha": "nodes/thz504-ha.js",
      "thz504-diagnose": "nodes/thz504-diagnose.js"
    }
  },
  "files": [
    "nodes",
    "lib",
    "registers",
    "examples",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
