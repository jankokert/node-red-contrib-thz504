{
  "name": "node-red-contrib-thz504",
  "version": "0.5.0",
  "description": "Read-only Node-RED nodes for the Tecalor THZ 504 / Stiebel Eltron LWZ 504 heat pump via CAN bus (Elster protocol): register catalog, diagnosis and Home Assistant MQTT discovery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jankokert/node-red-contrib-thz504.git"
  },
  "bugs": {
    "url": "https://github.com/jankokert/node-red-contrib-thz504/issues"
  },
  "homepage": "https://github.com/jankokert/node-red-contrib-thz504#readme",
  "keywords": [
    "node-red",
    "tecalor",
    "thz504",
    "thz-504",
    "stiebel-eltron",
    "lwz504",
    "heat-pump",
    "waermepumpe",
    "can",
    "socketcan",
    "elster",
    "home-assistant",
    "mqtt"
  ],
  "license": "MIT",
  "author": "Jan Kokert",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "thz504-read": "nodes/thz504-read.js",
      "thz504-ha": "nodes/thz504-ha.js",
      "thz504-diagnose": "nodes/thz504-diagnose.js"
    }
  },
  "files": [
    "nodes",
    "lib",
    "registers",
    "examples",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
